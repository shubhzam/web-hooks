// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ids are uuidv7 generated in app code, so there are no database defaults on them

model Organization {
  id        String   @id @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  apiKeys   ApiKey[]
  endpoints WebhookEndpoint[]

  @@map("organizations")
}

model ApiKey {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // first 8 chars of the random part, safe to show in a ui
  keyPrefix      String    @map("key_prefix")
  // sha-256 hex of the full key, the key itself is never stored
  keyHash        String    @unique @map("key_hash")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("api_keys")
}

enum EndpointStatus {
  active
  disabled

  @@map("endpoint_status")
}

// the partial unique index on (organization_id, url) where deleted_at is null lives in the
// migration sql, prisma cannot declare it. if you change url, organizationId or deletedAt here,
// check that index in prisma/migrations/*_webhook_registration/migration.sql
model WebhookEndpoint {
  id             String         @id @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  url            String
  description    String?
  // plaintext on purpose, hmac signing needs the raw value at delivery time
  signingSecret  String         @map("signing_secret")
  status         EndpointStatus @default(active)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)
  // set by the circuit breaker, deliveries to this endpoint wait until it has passed
  pausedUntil    DateTime?      @map("paused_until") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization               @relation(fields: [organizationId], references: [id])
  eventTypes   WebhookEndpointEventType[]
  deliveries   Delivery[]

  @@index([organizationId, id])
  @@map("webhook_endpoints")
}

model WebhookEndpointEventType {
  endpointId String @map("endpoint_id") @db.Uuid
  eventType  String @map("event_type")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@id([endpointId, eventType])
  // feature 3 looks endpoints up by event type
  @@index([eventType])
  @@map("webhook_endpoint_event_types")
}

enum DeliveryStatus {
  pending
  in_progress
  succeeded
  exhausted

  @@map("delivery_status")
}

// one row per accepted event, the payload is stored once and not copied into every delivery.
// organization_id is not a foreign key: the api trusts the caller on it, so an event can name an
// organization that does not exist, and it simply matches no endpoints
model Event {
  eventId        String   @id @map("event_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  type           String
  payload        Json
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt     DateTime @map("received_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deliveries Delivery[]

  @@map("events")
}

// two partial indexes live in migration sql, prisma cannot declare them:
// deliveries_pending_next_attempt_idx on (next_attempt_at) where status = 'pending'
// deliveries_in_progress_lease_idx on (lease_expires_at) where status = 'in_progress'
// if you change status, nextAttemptAt or leaseExpiresAt here, check them in prisma/migrations
model Delivery {
  // uuidv7 generated in app code
  id             String         @id @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  endpointId     String         @map("endpoint_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  status         DeliveryStatus @default(pending)
  attemptCount   Int            @default(0) @map("attempt_count")
  nextAttemptAt  DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  // set while a worker holds the delivery, the reaper recovers rows whose lease ran out
  leaseExpiresAt DateTime?      @map("lease_expires_at") @db.Timestamptz(3)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(3)
  // attempt_count when the last replay happened, attempt_count minus this is the position in the retry schedule
  replayBase     Int            @default(0) @map("replay_base")
  // start of the current retry cycle, reset by a replay, the max age is measured from here
  cycleStartedAt DateTime       @default(now()) @map("cycle_started_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  event    Event            @relation(fields: [eventId], references: [eventId])
  endpoint WebhookEndpoint   @relation(fields: [endpointId], references: [id])
  attempts DeliveryAttempt[]

  // the conflict target that makes replays and duplicate events safe
  @@unique([eventId, endpointId])
  // the dashboard lists newest first with id < cursor, ids are uuidv7 so id order is creation order
  @@index([organizationId, id])
  @@index([endpointId, id])
  @@map("deliveries")
}

// one row per attempt, written in the same transaction as the outcome. error is a short code
// such as timeout or http_500, never a message, because messages can carry urls or bodies
model DeliveryAttempt {
  // uuidv7 generated in app code
  id             String   @id @db.Uuid
  deliveryId     String   @map("delivery_id") @db.Uuid
  attemptNumber  Int      @map("attempt_number")
  startedAt      DateTime @map("started_at") @db.Timestamptz(3)
  durationMs     Int?     @map("duration_ms")
  responseStatus Int?     @map("response_status")
  error          String?

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@unique([deliveryId, attemptNumber])
  @@map("delivery_attempts")
}
