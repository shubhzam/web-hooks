{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env --include ../../packages/shared/dist src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "create-org": "tsx --env-file=../../.env src/scripts/create-org.ts",
    "smoke:registration": "tsx --env-file=../../.env src/scripts/smoke-registration.ts",
    "smoke:ingest": "tsx --env-file=../../.env src/scripts/smoke-ingest.ts",
    "processor:dev": "tsx watch --env-file=../../.env --include ../../packages/shared/dist src/processor.ts",
    "start:processor": "node dist/processor.js",
    "smoke:fanout": "tsx --env-file=../../.env src/scripts/smoke-fanout.ts",
    "delivery:dev": "tsx watch --env-file=../../.env --include ../../packages/shared/dist src/delivery-worker.ts",
    "start:delivery": "node dist/delivery-worker.js",
    "check:ssrf": "tsx --env-file=../../.env src/scripts/check-ssrf.ts",
    "smoke:delivery": "tsx --env-file=../../.env src/scripts/smoke-delivery.ts",
    "check:retry": "tsx --env-file=../../.env src/scripts/check-retry.ts",
    "smoke:retries": "tsx --env-file=../../.env src/scripts/smoke-retries.ts",
    "check:dashboard": "tsx --env-file=../../.env src/scripts/check-dashboard.ts",
    "smoke:dashboard-api": "tsx --env-file=../../.env src/scripts/smoke-dashboard-api.ts",
    "smoke:web": "tsx --env-file=../../.env src/scripts/smoke-web.ts"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@repo/shared": "workspace:*",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "undici": "^8.12.4",
    "uuidv7": "1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "26.4.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
